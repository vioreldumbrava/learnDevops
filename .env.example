# Copy to .env and adjust. .env is gitignored.

# --- API ---
PORT=8080

# --- Postgres ---
POSTGRES_USER=dojo
POSTGRES_PASSWORD=change-me-locally
POSTGRES_DB=dojo
# Assembled connection string used by the api, worker and migrate services.
DATABASE_URL=postgres://dojo:change-me-locally@db:5432/dojo?sslmode=disable

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- Observability ---
# Host:port of the OTLP/HTTP receiver (Tempo). Empty disables tracing.
OTEL_EXPORTER_OTLP_ENDPOINT=tempo:4318
OTEL_SERVICE_NAME=dojo-api
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# --- Production / Caddy ---
# Local HTTP test: ":80". Real HTTPS: your domain e.g. "dojo.example.com".
SITE_DOMAIN=:80
ACME_EMAIL=admin@example.com

# --- Frontend ---
# Base path the browser uses to reach the API (relative works behind Caddy/nginx).
VITE_API_BASE=/api
