# Copy to .env (gitignored) and adjust.

# --- LLM backend (OpenAI-compatible) — pick ONE OPENAI_BASE_URL ---
# A) Local Ollama in Compose (start with:  docker compose --profile local-llm up)
OPENAI_BASE_URL=http://ollama:11434/v1
# B) Ollama on ANOTHER PC on your LAN (that PC must set OLLAMA_HOST=0.0.0.0:11434):
# OPENAI_BASE_URL=http://192.168.1.50:11434/v1
# C) LM Studio on ANOTHER PC (enable "Serve on Local Network" in its server tab):
# OPENAI_BASE_URL=http://192.168.1.50:1234/v1
# D) LM Studio on THIS host (from inside Docker):
# OPENAI_BASE_URL=http://host.docker.internal:1234/v1
OPENAI_API_KEY=not-needed-for-local

CHAT_MODEL=llama3.2:3b
EMBED_MODEL=nomic-embed-text

# --- Vector store ---
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=dojo_docs

# --- RAG behaviour ---
TOP_K=4
MIN_SCORE=0.35
CHUNK_SIZE=900
CHUNK_OVERLAP=150
