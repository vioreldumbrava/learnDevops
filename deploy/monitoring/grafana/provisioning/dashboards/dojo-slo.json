{
  "uid": "dojo-slo",
  "title": "DevOps Dojo · SLO & error budget",
  "tags": ["dojo", "slo", "lab-56"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    {
      "type": "gauge",
      "title": "30-day error budget remaining",
      "description": "1.0 = untouched, 0 = spent. This is the number that decides whether you ship.",
      "gridPos": { "h": 7, "w": 6, "x": 0, "y": 0 },
      "targets": [
        {
          "refId": "A",
          "expr": "job:slo_availability_budget_remaining:ratio30d",
          "datasource": { "type": "prometheus", "uid": "prometheus" }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": 0.25 },
              { "color": "green", "value": 0.5 }
            ]
          }
        },
        "overrides": []
      },
      "options": { "showThresholdMarkers": true, "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "type": "timeseries",
      "title": "Availability burn rate (× budget)",
      "description": "How many times faster than sustainable the budget is being spent. The thresholds are the alert thresholds: 14.4x pages, 6x pages, 1x is break-even.",
      "gridPos": { "h": 7, "w": 18, "x": 6, "y": 0 },
      "targets": [
        {
          "refId": "A",
          "expr": "job:slo_availability_error:ratio_rate5m / 0.005",
          "legendFormat": "5m",
          "datasource": { "type": "prometheus", "uid": "prometheus" }
        },
        {
          "refId": "B",
          "expr": "job:slo_availability_error:ratio_rate1h / 0.005",
          "legendFormat": "1h",
          "datasource": { "type": "prometheus", "uid": "prometheus" }
        },
        {
          "refId": "C",
          "expr": "job:slo_availability_error:ratio_rate6h / 0.005",
          "legendFormat": "6h",
          "datasource": { "type": "prometheus", "uid": "prometheus" }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "min": 0,
          "custom": { "fillOpacity": 5, "lineWidth": 2 },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "orange", "value": 6 },
              { "color": "red", "value": 14.4 }
            ]
          }
        },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } }
    },
    {
      "type": "stat",
      "title": "Availability SLI (1h)",
      "description": "Fraction of requests that did NOT return 5xx. SLO target: 99.5%.",
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 7 },
      "targets": [
        {
          "refId": "A",
          "expr": "1 - job:slo_availability_error:ratio_rate1h",
          "datasource": { "type": "prometheus", "uid": "prometheus" }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 3,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 0.995 }
            ]
          }
        },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value" }
    },
    {
      "type": "stat",
      "title": "Latency SLI (1h)",
      "description": "Fraction of requests served in under 500ms, read straight off the histogram bucket.",
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 7 },
      "targets": [
        {
          "refId": "A",
          "expr": "1 - job:slo_latency_error:ratio_rate1h",
          "datasource": { "type": "prometheus", "uid": "prometheus" }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 3,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 0.995 }
            ]
          }
        },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value" }
    },
    {
      "type": "timeseries",
      "title": "Latency burn rate (× budget)",
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 7 },
      "targets": [
        {
          "refId": "A",
          "expr": "job:slo_latency_error:ratio_rate5m / 0.005",
          "legendFormat": "5m",
          "datasource": { "type": "prometheus", "uid": "prometheus" }
        },
        {
          "refId": "B",
          "expr": "job:slo_latency_error:ratio_rate1h / 0.005",
          "legendFormat": "1h",
          "datasource": { "type": "prometheus", "uid": "prometheus" }
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "none", "min": 0, "custom": { "fillOpacity": 5, "lineWidth": 2 } },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } }
    },
    {
      "type": "timeseries",
      "title": "Request rate by status class (req/s)",
      "description": "The raw signal underneath the SLI — useful for sanity-checking that a burn spike is real and not a traffic collapse.",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 13 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (status) (rate(dojo_http_requests_total[5m]))",
          "legendFormat": "{{status}}",
          "datasource": { "type": "prometheus", "uid": "prometheus" }
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "reqps", "custom": { "fillOpacity": 10, "stacking": { "mode": "normal" } } },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } }
    }
  ]
}
